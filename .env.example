# ─── Chitragupta configuration ───────────────────────────────────────────────
# Copy to .env and fill in what you need. Everything has a sane local default;
# nothing here is required to run the core app + MCP server.

# Where the local "brain" lives. Default: ~/Library/Chitragupta — the macOS
# convention for per-app data. Change to any absolute path.
# CHITRAGUPTA_HOME=

# ─── Embeddings ────────────────────────────────────────────────────────────
# Provider used to turn text into vectors for semantic recall.
#   hash    -> zero-dependency, fully offline, deterministic. Works day one.
#   local   -> sentence-transformers (needs `pip install .[local-embeddings]`)
#   openai  -> OpenAI embeddings API (needs OPENAI_API_KEY)
#   gemini  -> Google embeddings API (needs GEMINI_API_KEY)
CHITRAGUPTA_EMBEDDING_PROVIDER=hash
# CHITRAGUPTA_EMBEDDING_MODEL=            # override default model per provider

# ─── LLM backend for agents (bring your own model) ─────────────────────────
# Which model the agents run on:
#   mock         -> offline deterministic (default; runs with zero keys)
#   subscription -> your paid ChatGPT/Claude/Cursor session via a local gateway
#   anthropic    -> Claude via ANTHROPIC_API_KEY
#   openai       -> GPT via OPENAI_API_KEY
#   openrouter   -> hundreds of models via OPENROUTER_API_KEY
#   ollama       -> free local models (Ollama running on :11434)
CHITRAGUPTA_MODEL_PROVIDER=mock
# CHITRAGUPTA_MODEL_NAME=

# ─── API keys (only for the providers/connectors you actually use) ─────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# Subscription gateway (OpenAI-compatible) for the 'subscription' provider:
# CHITRAGUPTA_SUBSCRIPTION_BASE_URL=http://localhost:8080/v1

# ─── Gmail / Google Drive (OAuth) ──────────────────────────────────────────
# Path to your Google OAuth client_secret.json (Desktop app credentials).
# GOOGLE_CLIENT_SECRETS=~/Library/Chitragupta/google_client_secret.json

# ─── Notion ────────────────────────────────────────────────────────────────
# Internal integration token (starts with `secret_` or `ntn_`).
# NOTION_TOKEN=

# ─── Server ────────────────────────────────────────────────────────────────
CHITRAGUPTA_HOST=127.0.0.1
CHITRAGUPTA_PORT=8787
