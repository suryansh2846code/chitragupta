.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.env
*.db
*.db-wal
*.db-shm
google_token.json

# never commit personal OAuth secrets (per-user Web/token clients & tokens)
client_secret*.json
google_client_secret.json

# NOTE: chitragupta/data/google_client.json IS committed on purpose — it is an
# "installed" (Desktop app) OAuth client. Google treats installed-app secrets as
# non-confidential (security is PKCE + the localhost redirect), so shipping it
# gives testers one-click sign-in. If GitHub secret-scanning ever revokes it,
# regenerate a Desktop client in Cloud Console and replace this file.

# build artefacts
dist/
build/
*.dmg
*.spec.bak

# …except the character package's bundle, which is a SHIPPED artefact, not a
# local build output. It is what `<script src>` consumers load, what
# `scripts/sync-character.sh` copies into `chitragupta/web/`, and what
# `tests/test_character_asset.py` compares the served copy against — a test
# that silently skips when the file is absent, which is exactly what `dist/`
# was quietly causing.
!character/dist/
!character/dist/**

# Claude Code scratch state; the repo's own rules live in CLAUDE.md files.
.claude/
.coverage
.coverage.*
htmlcov/

# macOS, and tool caches. .DS_Store was tracked until 2026-09-13; Finder writes
# it into any directory you so much as look at, so it lands in unrelated diffs.
.DS_Store
.mypy_cache/
.ruff_cache/
# A 7 MB 3D asset that rode in on an unrelated commit and is referenced by no
# code. Kept on disk, out of the repo.
*.usdz

# Chromium downloaded for the browser integration tests
.pw-browsers/
